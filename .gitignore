# ==============================================================================
# ASH JEWELLERY — UNIFIED ROOT GITIGNORE
# Covers entire monorepo (root, frontend, backend)
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production Builds & Bundler Caches
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
.vite/
*/.vite/
*.tsbuildinfo
.eslintcache

# Environment Variables (Keep sensitive secrets out of git)
.env
.env.*
*/.env
*/.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Exception: Always track example environment templates
!.env.example
!*/.env.example

# Logs & Runtime Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test Coverage
coverage/
*/coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Temporary / Scratch Files
scratch/
*/scratch/
*.tmp
*.temp
