{
  "name": "ash-jewellery-backend",
  "version": "1.0.0",
  "description": "Backend API and database layer for ASH Jewellery",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "create-admin": "node --dns-result-order=ipv4first scripts/createAdmin.js",
    "db:seed:admin": "node --dns-result-order=ipv4first prisma/seed_super_admin.js",
    "test:auth": "node --dns-result-order=ipv4first scripts/test_phase11_auth.mjs",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
