# ==============================================================================
# ASH Jewellery — Backend Environment Variables (Neon PostgreSQL + Express)
# ==============================================================================

# PostgreSQL database connection string
# Format: postgresql://[user]:[password]@[hostname]:[port]/[dbname]?sslmode=require
DATABASE_URL=

# Express server port
PORT=5000

# Frontend application URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# JWT secret key for token generation and authentication
JWT_SECRET=

# Storage Service Configuration
# Provider: 'local' (development default) or 's3' (AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=local
MEDIA_MAX_FILE_SIZE=10485760
STORAGE_LOCAL_BASE_URL=http://localhost:5000/uploads

# S3 Configuration (only needed if STORAGE_PROVIDER=s3)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
